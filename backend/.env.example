# --- Çalışma ortamı ---
ENV=development                  # production iken aşağıdaki güvenlik denetimleri zorunludur
DATABASE_URL=sqlite:///./krizyolda_dev.db   # üretimde PostgreSQL: postgresql://kullanici:parola@host:5432/krizyolda
SECRET_KEY=                      # en az 32 karakter rastgele değer (örn. openssl rand -hex 32)
ENCRYPTION_KEY=                  # kaynak kimlik bilgilerini şifreler (Fernet anahtarı); boşsa SECRET_KEY'den türetilir
YONETICI_EPOSTALARI=             # virgülle ayrılmış; bu adresler kayıtta yönetici (uzman paneli) rolü alır
CORS_ORIGINS=http://localhost:5173
WORKER_GOMULU=false              # true: tarama işçisi API süreci içinde çalışır (tek süreçli kurulum)

# --- Bildirim (kriz uyarısı ve haftalık rapor e-postaları) ---
SMTP_HOST=
SMTP_PORT=587                    # 465 portunda otomatik SSL
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
PANEL_URL=http://localhost:5173  # e-postadaki bağlantılar bu adrese gider; üretimde https://panel.alanadiniz.com
BILDIRIM_EN_FAZLA_DENEME=6
BILDIRIM_BEKLEME_SAAT_VARSAYILAN=6
SLACK_WEBHOOK_URL=

# --- Açık kaynaklar (anahtar gerektirmez) ---
ERKIS_EK_RSS=                    # tüm kurumlar için ek RSS adresleri (virgülle)
GOOGLE_TRENDS_ENABLED=true
REDDIT_ACIK_ARAMA=true

# --- Tarama ---
TARAMA_ARALIGI_MIN=15
TARAMA_ARALIGI_MAX=360
ISCI_BEKLEME_SN=30

# --- Yöntem seçenekleri ---
ERKIS_DUYGU_MOTORU=sozluk        # sozluk | turkishbertweet
ERKIS_SCCT_MOTORU=tohum          # tohum | sifir_atis
ERKIS_Z_YONTEMI=stouffer         # stouffer | strube
ERKIS_DIL_FILTRESI=0
ERKIS_NRC_YOLU=
